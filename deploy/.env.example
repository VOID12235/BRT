# ==========================================================================
# BTR 赛事平台 · 生产环境变量
# 复制为 deploy/.env 后修改；切勿把真实 .env 提交到版本库。
# ==========================================================================

# 对外 HTTP 端口
HTTP_PORT=80

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=please-change-root-password
DB_NAME=btr
DB_USER=btr
DB_PASSWORD=please-change-db-password

# ---------- Redis ----------
# 默认不设密码（仅容器内网访问）；如需开启请同时配置 redis 命令与后端
REDIS_PASSWORD=

# ---------- 安全 ----------
# 至少 32 位随机字符串，可用 `openssl rand -base64 48` 生成
JWT_SECRET=please-change-to-a-long-random-secret-at-least-32-chars
CAPTCHA_ENABLED=true
# 允许跨域访问的来源，多个用逗号分隔；同域部署可填实际域名
CORS_ORIGINS=http://localhost

# ---------- 首次启动管理员 ----------
# 留空则不会自动创建管理员。设置后首次启动会创建该账号，已存在则跳过。
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=please-change-admin-password
ADMIN_NICKNAME=平台管理员
ADMIN_EMAIL=admin@example.com

# ---------- 演示数据 ----------
# 生产环境务必保持 false；仅演示/验收环境可设为 true
SEED_DEMO=false

# ---------- 邮件通知（可选） ----------
# 未配置时邮件记录为 SKIPPED，不影响报名、评审与公示流程
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
